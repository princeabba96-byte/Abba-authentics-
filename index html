function closeModal(){

  $("modal")
    .classList.add("hidden");

}


/* =========================
   WHATSAPP
========================= */

function contactWhatsApp(number,text){

  let n =
    String(number || "")
      .replace(/\D/g,"");

  if(n.startsWith("0")){
    n =
      "234" +
      n.substring(1);
  }

  window.open(
    "https://wa.me/" +
    n +
    "?text=" +
    encodeURIComponent(text),
    "_blank"
  );

}
<script>
/* =========================
   SELLER VERIFICATION
========================= */

async function requestSellerVerification(){

  if(!currentUser){
    showToast("Please login first.");
    return;
  }

  const message =
    prompt(
      "Tell ABBA AUTHENTICS why you want to become a verified seller:"
    ) || "";

  try{

    const { error } =
      await db
        .from("seller_verification_requests")
        .insert({
          user_id: currentUser.id,
          status: "pending",
          message: message
        });

    if(error) throw error;

    showToast(
      "Verification request sent ✓"
    );

  }catch(error){

    console.error(error);

    showToast(
      "Could not send verification request."
    );

  }

}


/* =========================
   NOTIFICATIONS
========================= */

async function enableNotifications(){

  try{

    if(typeof OneSignal === "undefined"){

      showToast(
        "Notification service is loading. Try again."
      );

      return;
    }

    await OneSignal.Notifications.requestPermission();

    showToast(
      "Notification permission requested 🔔"
    );

  }catch(error){

    console.error(error);

    showToast(
      "Could not enable notifications."
    );

  }

}


/* =========================
   JAVA ASSISTANT
========================= */

function toggleJAVA(){

  const box = $("javaBox");

  if(!box) return;

  box.classList.toggle("show");

}


function askJAVA(){

  const input = $("javaInput");

  if(!input) return;

  const question =
    input.value.trim();

  if(!question) return;

  const answer =
    getJAVAAnswer(question);

  const chat =
    $("javaChat");

  if(chat){

    chat.innerHTML +=
      `
      <div class="java-user">
        ${escapeHTML(question)}
      </div>

      <div class="java-bot">
        ${answer}
      </div>
      `;

    chat.scrollTop =
      chat.scrollHeight;

  }

  input.value = "";

}


function getJAVAAnswer(question){

  const q =
    question.toLowerCase();

  if(
    q.includes("hello") ||
    q.includes("hi") ||
    q.includes("hey")
  ){

    return "Hello 👋 I'm JAVA, your ABBA AUTHENTICS assistant. How can I help you?";

  }

  if(
    q.includes("verified seller") ||
    q.includes("seller verification")
  ){

    return "A seller can request verification from their account. The ABBA AUTHENTICS administrator reviews the request before verification is granted.";

  }

  if(
    q.includes("product authenticated") ||
    q.includes("authenticate product")
  ){

    return "PRODUCT AUTHENTICATED means that ABBA AUTHENTICS has specifically checked and authenticated that product. A verified seller does not automatically mean every product they sell is authenticated.";

  }

  if(
    q.includes("whatsapp") ||
    q.includes("contact seller")
  ){

    return "Open the seller or product profile and use the WhatsApp contact button to contact the seller.";

  }

  if(
    q.includes("search")
  ){

    return "Use the SEARCH page to search for sellers, customers, products, businesses and other available information.";

  }

  if(
    q.includes("account")
  ){

    return "Your ACCOUNT page contains your profile information, seller verification status and account options.";

  }

  return "I'm JAVA 🤖. I can help you understand ABBA AUTHENTICS, products, sellers, verification and how to use the website.";

}


/* =========================
   ADMIN FUNCTIONS
========================= */

async function adminLoadRequests(){

  if(!isAdmin) return;

  const box =
    $("adminRequests");

  if(!box) return;

  box.innerHTML =
    "Loading verification requests...";

  const { data, error } =
    await db
      .from("seller_verification_requests")
      .select("*")
      .eq("status","pending")
      .order("created_at",{ascending:false});

  if(error){

    console.error(error);

    box.innerHTML =
      "Could not load requests.";

    return;
  }

  if(!data || data.length === 0){

    box.innerHTML =
      "<p>No pending verification requests.</p>";

    return;
  }

  box.innerHTML =
    data.map(request => {

      const seller =
        profiles.find(
          p => p.id === request.user_id
        );

      return `
        <div class="admin-request">

          <b>
            ${escapeHTML(
              seller?.display_name ||
              seller?.email ||
              "Unknown seller"
            )}
          </b>

          <p>
            ${escapeHTML(
              request.message || "No message"
            )}
          </p>

          <button
            onclick="approveSeller('${request.id}','${request.user_id}')"
          >
            ✓ VERIFY SELLER
          </button>

          <button
            onclick="rejectSeller('${request.id}')"
          >
            REJECT
          </button>

        </div>
      `;

    }).join("");

}


async function approveSeller(
  requestId,
  userId
){

  if(!isAdmin) return;

  try{

    const { error:updateError } =
      await db
        .from("profiles")
        .update({
          is_verified_seller:true
        })
        .eq("id",userId);

    if(updateError)
      throw updateError;

    const { error:requestError } =
      await db
        .from("seller_verification_requests")
        .update({
          status:"approved"
        })
        .eq("id",requestId);

    if(requestError)
      throw requestError;

    showToast(
      "Seller verified ✓"
    );

    await loadData();

    adminLoadRequests();

  }catch(error){

    console.error(error);

    showToast(
      "Could not verify seller."
    );

  }

}


async function rejectSeller(
  requestId
){

  if(!isAdmin) return;

  try{

    const { error } =
      await db
        .from("seller_verification_requests")
        .update({
          status:"rejected"
        })
        .eq("id",requestId);

    if(error) throw error;

    showToast(
      "Verification request rejected."
    );

    adminLoadRequests();

  }catch(error){

    console.error(error);

    showToast(
      "Could not reject request."
    );

  }

}


