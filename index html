<script>

/* =========================
   GLOBAL VARIABLES
========================= */

let currentUser = null;
let currentProfile = null;
let products = [];
let profiles = [];


/* =========================
   SHORTCUT
========================= */

function $(id){
  return document.getElementById(id);
}


/* =========================
   AUTH SCREEN
========================= */

function showSignup(){

  $("loginBox").classList.add("hidden");

  $("signupBox").classList.remove("hidden");

}


function showLogin(){

  $("signupBox").classList.add("hidden");

  $("loginBox").classList.remove("hidden");

}


/* =========================
   SIGN UP
========================= */

async function signup(){

  const email =
    $("signupEmail").value.trim();

  const password =
    $("signupPassword").value;

  const password2 =
    $("signupPassword2").value;

  const msg =
    $("signupMsg");

  msg.textContent = "";

  if(!email.toLowerCase().endsWith("@gmail.com")){

    msg.textContent =
      "Please use a Gmail address.";

    msg.className =
      "msg error";

    return;
  }

  if(password.length < 6){

    msg.textContent =
      "Password must be at least 6 characters.";

    msg.className =
      "msg error";

    return;
  }

  if(password !== password2){

    msg.textContent =
      "Passwords do not match.";

    msg.className =
      "msg error";

    return;
  }


  const {data,error} =
    await db.auth.signUp({

      email:email,

      password:password,

      options:{
        emailRedirectTo:
          window.location.href
      }

    });


  if(error){

    msg.textContent =
      error.message;

    msg.className =
      "msg error";

    return;
  }


  msg.textContent =
    data.session
      ? "Account created successfully."
      : "Check your Gmail to verify your account.";

  msg.className =
    "msg success";

}


/* =========================
   LOGIN
========================= */

async function login(){

  const email =
    $("loginEmail").value.trim();

  const password =
    $("loginPassword").value;

  const msg =
    $("loginMsg");


  const {data,error} =
    await db.auth.signInWithPassword({

      email:email,

      password:password

    });


  if(error){

    msg.textContent =
      "Invalid login credentials";

    msg.className =
      "msg error";

    return;
  }


  await afterLogin(data.user);

}


/* =========================
   AFTER LOGIN
========================= */

async function afterLogin(user){

  currentUser = user;


  const {data,error} =
    await db
      .from("profiles")
      .select("*")
      .eq("id",user.id)
      .maybeSingle();


  if(error){

    console.error(error);

  }


  if(!data){

    $("authScreen")
      .classList.add("hidden");

    $("profileSetup")
      .classList.remove("hidden");

    return;
  }


  currentProfile = data;

  enterWebsite();

}


/* =========================
   PROFILE
========================= */

async function saveProfile(){

  const name =
    $("profileName").value.trim();

  const location =
    $("profileLocation").value.trim();

  const whatsapp =
    $("profileWhatsapp").value.trim();

  const about =
    $("profileAbout").value.trim();

  const file =
    $("profilePicture").files[0];

  const msg =
    $("profileMsg");


  if(!name){

    msg.textContent =
      "Please enter your name.";

    msg.className =
      "msg error";

    return;
  }


  let picture = "";


  if(file){

    const ext =
      file.name.split(".").pop();

    const fileName =
      currentUser.id +
      "-" +
      Date.now() +
      "." +
      ext;


    const upload =
      await db.storage
        .from("profile-pictures")
        .upload(
          fileName,
          file,
          {upsert:true}
        );


    if(upload.error){

      msg.textContent =
        upload.error.message;

      msg.className =
        "msg error";

      return;
    }


    picture =
      db.storage
        .from("profile-pictures")
        .getPublicUrl(fileName)
        .data.publicUrl;

  }


  const {data,error} =
    await db
      .from("profiles")
      .upsert({

        id:currentUser.id,

        email:currentUser.email,

        display_name:name,

        profile_picture:picture,

        location:location,

        whatsapp:whatsapp,

        seller_description:about

      })
      .select()
      .single();


  if(error){

    msg.textContent =
      error.message;

    msg.className =
      "msg error";

    return;
  }


  currentProfile = data;

  $("profileSetup")
    .classList.add("hidden");

  enterWebsite();

}


/* =========================
   ENTER WEBSITE
========================= */

async function enterWebsite(){

  $("authScreen")
    .classList.add("hidden");

  $("profileSetup")
    .classList.add("hidden");

  $("app")
    .classList.remove("hidden");


  const admin =
    isAdmin();


  $("accountType").textContent =
    admin
      ? "ADMINISTRATOR"
      : "CUSTOMER ACCOUNT";


  $("adminButton")
    .classList.toggle(
      "hidden",
      !admin
    );


  const avatar =
    currentProfile.profile_picture ||
    makeAvatar(
      currentProfile.display_name
    );


  $("topAvatar").src =
    avatar;

  $("accountAvatar").src =
    avatar;


  $("topName").textContent =
    currentProfile.display_name ||
    currentUser.email;


  $("accountName").textContent =
    currentProfile.display_name || "";


  $("accountEmail").textContent =
    currentUser.email || "";


  $("accountLocation").textContent =
    currentProfile.location ||
    "Not provided";


  $("accountWhatsapp").textContent =
    currentProfile.whatsapp ||
    "Not provided";


  $("accountAbout").textContent =
    currentProfile.seller_description ||
    "Not provided";


  $("accountBadge").innerHTML =
    currentProfile.is_verified_seller
      ? '<span class="badge verified">✓ VERIFIED SELLER</span>'
      : '<span class="badge">SELLER NOT VERIFIED</span>';


  await loadData();

  openPage("home");

}


/* =========================
   AVATAR
========================= */

function makeAvatar(name){

  const letters =
    (name || "AA")
      .split(" ")
      .map(x=>x[0])
      .join("")
      .substring(0,2)
      .toUpperCase();


  return "data:image/svg+xml;charset=UTF-8," +
    encodeURIComponent(

      `<svg xmlns="http://www.w3.org/2000/svg"
      width="200" height="200">

      <rect width="100%" height="100%"
      fill="#193b29"/>

      <text x="50%" y="55%"
      text-anchor="middle"
      font-size="70"
      font-family="Arial"
      fill="#45ed89">
      ${letters}
      </text>

      </svg>`

    );

}


/* =========================
   ADMIN
========================= */

function isAdmin(){

  return currentUser &&
    currentUser.email &&
    currentUser.email.toLowerCase()
      === ADMIN_EMAIL.toLowerCase();

}


/* =========================
   LOAD DATA
========================= */

async function loadData(){

  const p =
    await db
      .from("products")
      .select("*")
      .order(
        "created_at",
        {ascending:false}
      );


  products =
    p.data || [];


  const s =
    await db
      .from("profiles")
      .select("*");


  profiles =
    s.data || [];


  $("productCount").textContent =
    products.length;


  $("sellerCount").textContent =
    profiles.length;


  renderProducts(
    products,
    "homeProducts"
  );


  renderProducts(
    products,
    "allProducts"
  );


  if(isAdmin()){

    loadAdmin();

  }

}


/* =========================
   PRODUCT HELPERS
========================= */

function productName(p){

  return p.name ||
    p.product_name ||
    "Unnamed product";

}


function productImage(p){

  return p.image_url ||
    p.image ||
    p.product_image ||
    makeAvatar(productName(p));

}


function sellerOf(p){

  return profiles.find(
    x=>x.id===p.seller_id
  );

}


/* =========================
   RENDER PRODUCTS
========================= */

function renderProducts(list,id){

  const box = $(id);

  if(!box)return;


  if(!list.length){

    box.innerHTML =
      '<p>No products available yet.</p>';

    return;
  }


  box.innerHTML =
    list.map(p=>{

      const seller =
        sellerOf(p);


      return `

      <div class="product"
      onclick="openProduct('${p.id}')">

        <img
        src="${productImage(p)}">

        <div class="productBody">

          <b>
          ${productName(p)}
          </b>

          ${
            p.price != null
            ? `<div class="price">
                ₦${p.price}
               </div>`
            : ""
          }

          <small>
          Seller:
          ${seller?.display_name || "Seller"}
          </small>

          <br>

          ${
            seller?.is_verified_seller
            ?
            '<span class="badge verified">✓ VERIFIED SELLER</span>'
            :
            ''
          }

          ${
            p.authenticated
            ?
            '<span class="badge authenticated">✓ PRODUCT AUTHENTICATED</span>'
            :
            ''
          }

        <
            :
            ''
          }

        </div>

      </div>

      `;
      
    }).join("");

}


/* =========================
   PAGE NAVIGATION
========================= */

function openPage(page){

  document
    .querySelectorAll("main > section")
    .forEach(x =>
      x.classList.add("hidden")
    );

  const selected =
    $("page-" + page);

  if(selected){
    selected.classList.remove("hidden");
  }

  document
    .querySelectorAll(".nav button")
    .forEach(x =>
      x.classList.remove("active")
    );

  const button =
    document.querySelector(
      `[data-page="${page}"]`
    );

  if(button){
    button.classList.add("active");
  }

  if(page === "admin"){
    loadAdmin();
  }

}


/* =========================
   SEARCH
========================= */

function searchEverything(){

  const q =
    $("searchInput")
      .value
      .trim()
      .toLowerCase();

  if(!q){

    $("sellerResults").innerHTML =
      "<p>Search for a seller or customer.</p>";

    renderProducts(
      [],
      "searchProducts"
    );

    return;
  }

  const foundProfiles =
    profiles.filter(p => {

      return [

        p.display_name,
        p.email,
        p.location,
        p.seller_description,
        p.whatsapp

      ].some(value =>

        String(value || "")
          .toLowerCase()
          .includes(q)

      );

    });


  $("sellerResults").innerHTML =
    foundProfiles.length

    ?

    foundProfiles.map(p => `

      <div
        class="seller"
        onclick="openSeller('${p.id}')">

        <img
          src="${
            p.profile_picture ||
            makeAvatar(p.display_name)
          }">

        <div class="sellerInfo">

          <b>
            ${p.display_name || "Account"}
          </b>

          <br>

          ${
            p.is_verified_seller

            ?

            '<span class="badge verified">✓ VERIFIED SELLER</span>'

            :

            '<span class="badge">NOT VERIFIED</span>'
          }

          <br>

          <small>
            ${p.location || "Location not provided"}
          </small>

        </div>

      </div>

    `).join("")

    :

    "<p>No matching sellers.</p>";


  const foundProducts =
    products.filter(p => {

      const seller =
        sellerOf(p);

      return [

        productName(p),
        p.company_name,
        p.category,
        p.description,
        seller?.display_name,
        seller?.location

      ].some(value =>

        String(value || "")
          .toLowerCase()
          .includes(q)

      );

    });


  renderProducts(
    foundProducts,
    "searchProducts"
  );

}


