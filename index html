      isAdmin =
        currentUser.email?.toLowerCase() ===
        ADMIN_EMAIL.toLowerCase();

      await loadData();

      showApp();

    }else{

      currentUser = null;

      isAdmin = false;

      showLogin();

    }

  }
);


